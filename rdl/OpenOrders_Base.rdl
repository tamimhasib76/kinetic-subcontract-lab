        </Field>
        <Field Name="OrderDtl_PartNum">
          <DataField>OrderDtl_PartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderDtl_LineDesc">
          <DataField>OrderDtl_LineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderDtl_OrderQty">
