<?xml version="1.0" encoding="utf-8"?>
<!--
  rdl/OpenOrders_Base.rdl
  =======================
  Base Open Orders BAQ Report SSRS Definition (Starting ungrouped RDL for Lab R5)

  Citations & Banners:
  - Base SQL query is illustrative: Epicor's exact out-of-the-box SELECT list and join order
    are not reproduced from proprietary RDL text (Approved Default 17, docs/reference/decisions.md).
  - BAQ Report route (docs/reference/04-cloud-rules.md §2.2 [C1, S26, S27]): Queries
    `dbo.[BAQReportResult_" + Parameters!TableGuid.Value + "]` with `<Table>_<Field>`
    column names and `Calculated_DaysLate` (docs/reference/01-ssrs-forms.md Explicit Answer 3 [S26, S27];
    docs/reference/02-baq.md §3.4 & Explicit Answer 3 [B18]).
  - Lab design (Approved Default 22, docs/reference/decisions.md): Authored in the 2016/01 RDL schema
    namespace for SSRS 2016 / Report Builder 2016 compatibility. Note: Epicor Kinetic cloud may reject
    the 2016/01 RDL schema namespace on upload [S30].
  - Default chosen for the lab, not confirmed against Epicor: Shared DataSourceReference
    `ErpReportingDS` is a lab stand-in.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ErpReportingDS">
      <DataSourceReference>ErpReportingDS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111107</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="BAQReportResult">
      <Query>
        <DataSourceName>ErpReportingDS</DataSourceName>
        <CommandText>="/* Illustrative base query for lab training — not Epicor proprietary RDL text */ "
+ "SELECT T1.Customer_CustID, T1.Customer_Name, "
+ "T1.OrderHed_Company, T1.OrderHed_OrderNum, T1.OrderHed_PONum, T1.OrderHed_OrderDate, T1.OrderHed_NeedByDate, T1.OrderHed_OrderAmt, "
+ "T1.OrderDtl_OrderLine, T1.OrderDtl_PartNum, T1.OrderDtl_LineDesc, T1.OrderDtl_OrderQty, T1.OrderDtl_SalesUM, T1.OrderDtl_UnitPrice, "
+ "T1.Calculated_DaysLate, "
+ "T2.LblOpenOrdersTitle, T2.LblCustID, T2.LblCustName, T2.LblOrderNum, T2.LblOrderDate, "
+ "T2.LblNeedByDate, T2.LblDaysLate, T2.LblPartNum, T2.LblLineDesc, T2.LblOrderQty, T2.LblUnitPrice "
+ "FROM dbo.[BAQReportResult_" + Parameters!TableGuid.Value + "] T1 "
+ "CROSS JOIN dbo.[RptLabels_" + Parameters!TableGuid.Value + "] T2"</CommandText>
      </Query>
      <Fields>
        <Field Name="Customer_CustID">
          <DataField>Customer_CustID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_Name">
          <DataField>Customer_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderHed_Company">
          <DataField>OrderHed_Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderHed_OrderNum">
          <DataField>OrderHed_OrderNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderHed_PONum">
          <DataField>OrderHed_PONum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderHed_OrderDate">
          <DataField>OrderHed_OrderDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OrderHed_NeedByDate">
          <DataField>OrderHed_NeedByDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OrderHed_OrderAmt">
