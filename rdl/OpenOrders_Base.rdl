          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblCustID">
          <DataField>LblCustID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblCustName">
          <DataField>LblCustName</DataField>
