<?xml version="1.0" encoding="utf-8"?>
<!--
  rdl/ARForm.rdl
  ==============
  Base Accounts Receivable Invoice SSRS Report Definition (Starting RDL for Lab R4)

  Citations & Banners:
  - Base SQL query is illustrative: Epicor's exact out-of-the-box SELECT list and join order
    are not reproduced from proprietary RDL text (Approved Default 17, docs/reference/decisions.md).
  - Dataset expression pattern `="SELECT ... FROM Table_" + Parameters!TableGuid.Value` follows
    Epicor's SSRS staging table architecture (docs/reference/01-ssrs-forms.md Explicit Answer 1 & 5 [S13, S14, S19, S17, S18]).
  - Lab design (Approved Default 22, docs/reference/decisions.md): Authored in the 2016/01 RDL schema
    namespace for SSRS 2016 / Report Builder 2016 compatibility. Note: Epicor Kinetic cloud may reject
    the 2016/01 RDL schema namespace on upload [S30].
  - Default chosen for the lab, not confirmed against Epicor: Shared DataSourceReference
    `ErpReportingDS` is a lab stand-in.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ErpReportingDS">
      <DataSourceReference>ErpReportingDS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111105</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ARForm">
      <Query>
        <DataSourceName>ErpReportingDS</DataSourceName>
        <CommandText>="/* Illustrative base query for lab training — not Epicor proprietary RDL text */ "
+ "SELECT T1.Company, T1.InvoiceNum, T1.InvoiceDate, T1.OrderNum, T1.InvoiceAmt, T1.TermsCode, "
+ "T2.InvoiceLine, T2.PackNum, T2.PackLine, T2.PartNum, T2.LineDesc, T2.SellingShipQty, T2.UnitPrice, T2.ExtPrice, "
+ "T3.CustID, T3.Name AS CustName, T3.Address1 AS BillToAddress1, T3.City AS BillToCity, T3.State AS BillToState, T3.Zip AS BillToZip, "
+ "T5.LblInvoiceTitle, T5.LblInvoiceNum, T5.LblInvoiceDate, T5.LblOrderNum, T5.LblTermsCode, "
+ "T5.LblPartNum, T5.LblLineDesc, T5.LblShipQty, T5.LblUnitPrice, T5.LblExtPrice "
+ "FROM dbo.[InvcHead_" + Parameters!TableGuid.Value + "] T1 "
+ "INNER JOIN dbo.[InvcDtl_" + Parameters!TableGuid.Value + "] T2 ON T1.Company = T2.Company AND T1.InvoiceNum = T2.InvoiceNum "
+ "LEFT OUTER JOIN dbo.[Customer_" + Parameters!TableGuid.Value + "] T3 ON T1.Company = T3.Company AND T1.CustNum = T3.CustNum "
+ "CROSS JOIN dbo.[RptLabels_" + Parameters!TableGuid.Value + "] T5"</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InvoiceNum">
          <DataField>InvoiceNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InvoiceDate">
          <DataField>InvoiceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OrderNum">
          <DataField>OrderNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InvoiceAmt">
          <DataField>InvoiceAmt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TermsCode">
          <DataField>TermsCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InvoiceLine">
          <DataField>InvoiceLine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PackNum">
          <DataField>PackNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PackLine">
          <DataField>PackLine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PartNum">
          <DataField>PartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LineDesc">
          <DataField>LineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SellingShipQty">
          <DataField>SellingShipQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="UnitPrice">
          <DataField>UnitPrice</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ExtPrice">
          <DataField>ExtPrice</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CustID">
          <DataField>CustID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CustName">
          <DataField>CustName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BillToAddress1">
          <DataField>BillToAddress1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BillToCity">
          <DataField>BillToCity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BillToState">
          <DataField>BillToState</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BillToZip">
          <DataField>BillToZip</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblInvoiceTitle">
          <DataField>LblInvoiceTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblInvoiceNum">
          <DataField>LblInvoiceNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblInvoiceDate">
          <DataField>LblInvoiceDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblOrderNum">
          <DataField>LblOrderNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblTermsCode">
          <DataField>LblTermsCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblPartNum">
          <DataField>LblPartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblLineDesc">
          <DataField>LblLineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblShipQty">
          <DataField>LblShipQty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblUnitPrice">
          <DataField>LblUnitPrice</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblExtPrice">
          <DataField>LblExtPrice</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
