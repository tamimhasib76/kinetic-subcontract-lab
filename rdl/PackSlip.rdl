                    <Value>=First(Fields!LblCustNum.Value, "PackSlip") &amp; " " &amp; First(Fields!CustID.Value, "PackSlip") &amp; " - " &amp; First(Fields!CustName.Value, "PackSlip")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
