<?xml version="1.0" encoding="utf-8"?>
<!--
  rdl/PackSlip.rdl
  ================
  Base Packing Slip SSRS Report Definition (Starting RDL for Labs R1 and R2)

  Citations & Banners:
  - Base SQL query is illustrative: Epicor's exact out-of-the-box SELECT list and join order
    are not reproduced from proprietary RDL text (Approved Default 17, docs/reference/decisions.md).
  - Dataset expression pattern `="SELECT ... FROM Table_" + Parameters!TableGuid.Value` follows
    Epicor's SSRS staging table architecture (docs/reference/01-ssrs-forms.md Explicit Answer 1 & 5 [S13, S14, S19, S8]).
  - Lab design (Approved Default 22, docs/reference/decisions.md): Authored in the 2016/01 RDL schema
    namespace for SSRS 2016 / Report Builder 2016 compatibility. Note: Epicor Kinetic cloud may reject
    the 2016/01 RDL schema namespace on upload [S30].
  - Default chosen for the lab, not confirmed against Epicor: Shared DataSourceReference
    `ErpReportingDS` is a lab stand-in.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ErpReportingDS">
      <DataSourceReference>ErpReportingDS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111101</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="PackSlip">
      <Query>
        <DataSourceName>ErpReportingDS</DataSourceName>
        <CommandText>="/* Illustrative base query for lab training — not Epicor proprietary RDL text */ "
+ "SELECT T1.Company, T1.PackNum, T1.ShipDate, T1.TrackingNumber, T1.ShipViaCode, "
+ "T2.PackLine, T2.OrderNum, T2.OrderLine, T2.OrderRelNum, T2.PartNum, T2.LineDesc, "
+ "T2.SellingShippedQty, T2.SalesUM, "
+ "T3.CustID, T3.Name AS CustName, "
+ "T4.Name AS ShipToName, T4.Address1 AS ShipToAddress1, T4.City AS ShipToCity, T4.State AS ShipToState, T4.Zip AS ShipToZip, "
+ "T5.LblPackSlipTitle, T5.LblPackNum, T5.LblShipDate, T5.LblCustNum, T5.LblTrackingNumber, "
+ "T5.LblPartNum, T5.LblLineDesc, T5.LblShipQty "
+ "FROM dbo.[ShipHead_" + Parameters!TableGuid.Value + "] T1 "
+ "INNER JOIN dbo.[ShipDtl_" + Parameters!TableGuid.Value + "] T2 ON T1.Company = T2.Company AND T1.PackNum = T2.PackNum "
+ "LEFT OUTER JOIN dbo.[Customer_" + Parameters!TableGuid.Value + "] T3 ON T1.Company = T3.Company AND T1.CustNum = T3.CustNum "
+ "LEFT OUTER JOIN dbo.[ShipTo_" + Parameters!TableGuid.Value + "] T4 ON T1.Company = T4.Company AND T1.ShipToCustNum = T4.CustNum AND T1.ShipToNum = T4.ShipToNum "
+ "CROSS JOIN dbo.[RptLabels_" + Parameters!TableGuid.Value + "] T5"</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PackNum">
          <DataField>PackNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ShipDate">
          <DataField>ShipDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TrackingNumber">
          <DataField>TrackingNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipViaCode">
          <DataField>ShipViaCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PackLine">
          <DataField>PackLine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderNum">
          <DataField>OrderNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderLine">
          <DataField>OrderLine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderRelNum">
          <DataField>OrderRelNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PartNum">
          <DataField>PartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LineDesc">
          <DataField>LineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SellingShippedQty">
          <DataField>SellingShippedQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SalesUM">
          <DataField>SalesUM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CustID">
          <DataField>CustID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CustName">
          <DataField>CustName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipToName">
          <DataField>ShipToName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipToAddress1">
          <DataField>ShipToAddress1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipToCity">
          <DataField>ShipToCity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipToState">
          <DataField>ShipToState</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipToZip">
          <DataField>ShipToZip</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblPackSlipTitle">
          <DataField>LblPackSlipTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblPackNum">
          <DataField>LblPackNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblShipDate">
          <DataField>LblShipDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblCustNum">
          <DataField>LblCustNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblTrackingNumber">
          <DataField>LblTrackingNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblPartNum">
          <DataField>LblPartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblLineDesc">
          <DataField>LblLineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblShipQty">
          <DataField>LblShipQty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
