<?xml version="1.0" encoding="utf-8"?>
<!--
  rdl/OrderAck.rdl
  ================
  Base Sales Order Acknowledgment SSRS Report Definition (Starting RDL for Lab R3)

  Citations & Banners:
  - Base SQL query is illustrative: Epicor's exact out-of-the-box SELECT list and join order
    are not reproduced from proprietary RDL text (Approved Default 17, docs/reference/decisions.md).
  - Dataset expression pattern `="SELECT ... FROM Table_" + Parameters!TableGuid.Value` follows
    Epicor's SSRS staging table architecture (docs/reference/01-ssrs-forms.md Explicit Answer 1 & 5 [S13, S14, S19, S1, S24, S33]).
  - Lab design (Approved Default 22, docs/reference/decisions.md): Authored in the 2016/01 RDL schema
    namespace for SSRS 2016 / Report Builder 2016 compatibility. Note: Epicor Kinetic cloud may reject
    the 2016/01 RDL schema namespace on upload [S30].
  - Default chosen for the lab, not confirmed against Epicor: Shared DataSourceReference
    `ErpReportingDS` is a lab stand-in.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ErpReportingDS">
      <DataSourceReference>ErpReportingDS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111103</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="OrderAck">
      <Query>
        <DataSourceName>ErpReportingDS</DataSourceName>
        <CommandText>="/* Illustrative base query for lab training — not Epicor proprietary RDL text */ "
+ "SELECT T1.Company, T1.OrderNum, T1.OrderDate, T1.PONum, T1.NeedByDate, T1.OrderAmt, "
+ "T2.OrderLine, T2.PartNum, T2.LineDesc, T2.OrderQty, T2.SalesUM, T2.UnitPrice, "
+ "T2.PartNum_SteelGauge_c, T2.PartNum_PPAP_c, "
+ "T3.OrderRelNum, T3.OurReqQty, T3.NeedByDate AS RelNeedByDate, "
+ "T4.CustID, T4.Name AS CustName, "
+ "T5.LblOrderAckTitle, T5.LblOrderNum, T5.LblOrderDate, T5.LblPONum, T5.LblNeedByDate, "
+ "T5.LblPartNum, T5.LblLineDesc, T5.LblOrderQty, T5.LblUnitPrice "
+ "FROM dbo.[OrderHed_" + Parameters!TableGuid.Value + "] T1 "
+ "INNER JOIN dbo.[OrderDtl_" + Parameters!TableGuid.Value + "] T2 ON T1.Company = T2.Company AND T1.OrderNum = T2.OrderNum "
+ "LEFT OUTER JOIN dbo.[OrderRel_" + Parameters!TableGuid.Value + "] T3 ON T2.Company = T3.Company AND T2.OrderNum = T3.OrderNum AND T2.OrderLine = T3.OrderLine "
+ "LEFT OUTER JOIN dbo.[Customer_" + Parameters!TableGuid.Value + "] T4 ON T1.Company = T4.Company AND T1.CustNum = T4.CustNum "
+ "CROSS JOIN dbo.[RptLabels_" + Parameters!TableGuid.Value + "] T5"</CommandText>
      </Query>
      <Fields>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNum">
          <DataField>OrderNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OrderDate">
          <DataField>OrderDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PONum">
          <DataField>PONum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NeedByDate">
          <DataField>NeedByDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OrderAmt">
          <DataField>OrderAmt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OrderLine">
          <DataField>OrderLine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PartNum">
          <DataField>PartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LineDesc">
          <DataField>LineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderQty">
          <DataField>OrderQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SalesUM">
          <DataField>SalesUM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UnitPrice">
          <DataField>UnitPrice</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PartNum_SteelGauge_c">
          <DataField>PartNum_SteelGauge_c</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PartNum_PPAP_c">
          <DataField>PartNum_PPAP_c</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="OrderRelNum">
          <DataField>OrderRelNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OurReqQty">
          <DataField>OurReqQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="RelNeedByDate">
          <DataField>RelNeedByDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CustID">
          <DataField>CustID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CustName">
          <DataField>CustName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblOrderAckTitle">
          <DataField>LblOrderAckTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblOrderNum">
          <DataField>LblOrderNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblOrderDate">
          <DataField>LblOrderDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblPONum">
          <DataField>LblPONum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblNeedByDate">
          <DataField>LblNeedByDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblPartNum">
          <DataField>LblPartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblLineDesc">
          <DataField>LblLineDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblOrderQty">
          <DataField>LblOrderQty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LblUnitPrice">
          <DataField>LblUnitPrice</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
